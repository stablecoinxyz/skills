# SBC + Para + Radius — add to .env.example (copy to .env.local, never commit keys)

# SBC paymaster / bundler: https://dashboard.stablecoin.xyz/
NEXT_PUBLIC_SBC_API_KEY=
NEXT_PUBLIC_SBC_CHAIN=radiusTestnet

# Para wallet: https://developer.getpara.com/
NEXT_PUBLIC_PARA_API_KEY=

# Optional
# NEXT_PUBLIC_PARA_ENVIRONMENT=BETA
# NEXT_PUBLIC_APP_NAME=My SBC App

# Vite apps use VITE_SBC_API_KEY, VITE_PARA_API_KEY, VITE_SBC_CHAIN
