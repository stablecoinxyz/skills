# SBC + Para + Radius — add to .env.example (copy to .env.local, never commit keys)

# SBC paymaster / bundler: https://dashboard.stablecoin.xyz/
NEXT_PUBLIC_SBC_API_KEY=
NEXT_PUBLIC_SBC_CHAIN=radiusTestnet

# Para wallet: https://developer.getpara.com/
NEXT_PUBLIC_PARA_API_KEY=

# Radius RPC API key — server-side only (used by /api/radius-rpc proxy).
# Get a key at: https://docs.radiustech.xyz/developer-resources/network-configuration/
RADIUS_RPC_API_KEY=

# Local dev fallback when the server proxy gets Cloudflare 403 (common on some hosts).
# Full authenticated URL — browser calls Radius directly; key is in the client bundle (dev only).
# Host must match NEXT_PUBLIC_SBC_CHAIN (testnet: rpc.testnet.radiustech.xyz, mainnet: rpc.radiustech.xyz);
# a mismatched radiustech.xyz URL is ignored with a console warning.
# NEXT_PUBLIC_RADIUS_RPC_URL=https://rpc.testnet.radiustech.xyz/YOUR_RADIUS_RPC_KEY

# Alternative dev fallback (path-style key in bundle — avoid in production):
# NEXT_PUBLIC_RADIUS_RPC_API_KEY=

# Optional — external wallets (MetaMask, Coinbase, Rainbow, WalletConnect)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional
# NEXT_PUBLIC_PARA_ENVIRONMENT=BETA
# NEXT_PUBLIC_APP_NAME=My SBC App

# Vite apps use VITE_SBC_API_KEY, VITE_PARA_API_KEY, VITE_SBC_CHAIN, VITE_RADIUS_RPC_API_KEY
