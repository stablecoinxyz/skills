# SBC Radius — add to .env.example and .env.local (never commit real keys)

# Required: https://dashboard.stablecoin.xyz/
NEXT_PUBLIC_SBC_API_KEY=your_api_key_here

# radiusTestnet (default) | radius | radiusMainnet
NEXT_PUBLIC_SBC_CHAIN=radiusTestnet

# Optional override
# NEXT_PUBLIC_SBC_RPC_URL=https://rpc.testnet.radiustech.xyz
